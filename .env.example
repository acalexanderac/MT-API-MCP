# Credentials the server accepts over HTTP basic auth (organization id : API key)
MT_ORGANIZATION_ID=test-organization
MT_API_KEYS=test-api-key,second-api-key

PORT=4010

# false => sandbox/test mode (live_mode: false on every record, sandbox rate limits)
MT_LIVE_MODE=false

# off => skip the check entirely (handy for quick local probing)
MT_REQUIRE_AUTH=true
# off => disable the per-second rate limits
MT_RATE_LIMITS=on
# off => start with empty collections
MT_SEED=on
MT_SEED_COUNT=3
# off => no per-request log line
MT_LOGGING=on

# Deliver every event to this URL, signed with X-Signature (HMAC-SHA256)
# MT_WEBHOOK_URL=http://localhost:9000/webhooks
MT_WEBHOOK_KEY=webhook-key

# Persist the store between restarts
# MT_PERSIST_PATH=.data/store.json
